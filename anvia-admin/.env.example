# 複製成 .env.local 後填值（.env.local 不進 git）。
# 金鑰也可在後台「設定」頁填寫（存在資料庫，不進 repo）；環境變數優先。

# 管理端登入
ADMIN_PASSWORD=
SESSION_SECRET=            # 隨機長字串，用來簽登入 cookie

# 資料庫：不填 SUPABASE_URL 時，本機使用 data/dev-db.json（已被 .gitignore 排除）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 網站對外網址（藍新 NotifyURL / ReturnURL 用）
PUBLIC_BASE_URL=http://localhost:3000

# 藍新 NewebPay
NEWEBPAY_ENV=sandbox       # sandbox / production
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=

# LINE Messaging API（推播）
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login / LIFF（客人會員頁）
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# 僅本機測試會員頁：不經 LINE 登入，直接用此 line_uid 查詢（production 無效）
MEMBER_DEV_UID=
